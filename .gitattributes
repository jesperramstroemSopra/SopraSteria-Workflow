# Normalize line endings so the repo does not churn between Windows and CI.
* text=auto eol=lf

# Explicitly text
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.mjs     text eol=lf
*.js      text eol=lf

# Windows-only scripts keep CRLF
*.ps1     text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Binary
*.png     binary
*.jpg     binary
*.zip     binary
